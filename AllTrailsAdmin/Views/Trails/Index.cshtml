@model IEnumerable<AllTrailsAdmin.Models.Trail>

@{
    ViewData["Title"] = "Index";
}

<h1>All Trails</h1>

@if (User.IsInRole("administrator"))
{
    <p>
        <a asp-action="Create">Create New</a>
    </p>
}

<table class="table">
    <thead>
        <tr>
            <th>
                <!-- Image of Trail -->
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            @* <th>
                @Html.DisplayNameFor(model => model.Description)
            </th> *@
            <th>
                @Html.DisplayNameFor(model => model.Length)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ElevationGain)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Category)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                <img src="@item.ImageUrl" alt="@item.Title" class="thumbnail" />
            </td>
            <td>
                @Html.DisplayFor(model => item.Title)
            </td>
            @* <td>
                @Html.DisplayFor(model => item.Description)
            </td> *@
            <td>
                @Html.DisplayFor(model => item.Length)
            </td>
            <td>
                @Html.DisplayFor(model => item.ElevationGain)
            </td>
            <td>
                @Html.DisplayFor(model => item.Category.Title) @* Category nav property *@
            </td>
            <td>
                @Html.DisplayFor(model => item.CreatedDate)
            </td>
            <td>
                @if (User.IsInRole("administrator"))
                {
                    <div>
                        <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </div>    
                }
                else
                {
                    <div>
                        <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                    </div>
                }
            </td>
        </tr>
}
    </tbody>
</table>
