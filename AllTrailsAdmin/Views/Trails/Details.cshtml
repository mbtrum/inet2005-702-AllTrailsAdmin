@using Microsoft.AspNetCore.Html
@model AllTrailsAdmin.Models.Trail

@{
    ViewData["Title"] = "Details";
}

<h1 class="mb-4">Details  - @Html.DisplayFor(model => model.Title)</h1>

<img src="@Model.ImageUrl" alt="@Model.Title" class="w-50 mb-3" />

<dl>
    <dt class = "col-sm-2">
        @Html.DisplayNameFor(model => model.Description)
    </dt>
    <dd class = "col-sm-10">
        @* @Html.DisplayFor(model => model.Description) *@

        @{
            var descriptionWithBreaks = new HtmlString(Model.Description
                .Replace("\r\n", "<br />")
                .Replace("\n", "<br />")
                .Replace("\r", "<br />"));
        }

        @descriptionWithBreaks
    </dd>

    <dt class = "col-sm-2">
        @Html.DisplayNameFor(model => model.Length)
    </dt>
    <dd class = "col-sm-10">
        @Html.DisplayFor(model => model.Length)
    </dd>

    <dt class = "col-sm-2">
        @Html.DisplayNameFor(model => model.ElevationGain)
    </dt>
    <dd class = "col-sm-10">
        @Html.DisplayFor(model => model.ElevationGain)
    </dd>

    <dt class = "col-sm-2">
        @Html.DisplayNameFor(model => model.Location)
    </dt>
    <dd class = "col-sm-10">
        @Html.DisplayFor(model => model.Location)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.CategoryId)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.Category.Title) @* Category nav property *@
    </dd>

    <dt class = "col-sm-2">
        @Html.DisplayNameFor(model => model.CreatedDate)
    </dt>
    <dd class = "col-sm-10">
        @Html.DisplayFor(model => model.CreatedDate)
    </dd>
</dl>

<div>
    @if (User.IsInRole("administrator")) {
        <span>
            <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
        </span>
    }
    <a asp-action="Index">Back to List</a>
</div>
